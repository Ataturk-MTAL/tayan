<script lang="ts">
  import type { ContentNode } from '$lib/types';
  import katex from 'katex';

  let {
    nodes = [],
    onchange,
    placeholder = 'Metni buraya yazın…',
  }: {
    nodes?: ContentNode[];
    onchange?: (nodes: ContentNode[]) => void;
    placeholder?: string;
  } = $props();

  // ── Types ──────────────────────────────────────────────────────────────────

  type ImgEntry = { id: string; src: string; alt: string; align: 'left' | 'center' | 'right'; width: string; wrap: boolean };
  type TextStyle = { bold: boolean; italic: boolean; underline: boolean; strikethrough: boolean };

  // ── State ──────────────────────────────────────────────────────────────────

  let _idc    = 0;
  let imgList = $state<ImgEntry[]>(
    nodes
      .filter((n): n is Extract<ContentNode, { type: 'image' }> => n.type === 'image')
      .map((n, k) => ({ id: `i${k}`, src: n.src, alt: n.alt, align: n.align ?? 'center', width: n.width ?? '100%', wrap: n.wrap ?? false }))
  );
  if (imgList.length) _idc = imgList.length;

  let editorRef:    HTMLDivElement   | undefined = $state();
  let fileRef:      HTMLInputElement | undefined = $state();
  let mathInputRef: HTMLInputElement | undefined = $state();

  let showEqEditor     = $state(false);
  let showLatexRef     = $state(false);
  let eqCategory       = $state(0);
  let mathInputVisible = $state(false);
  let mathInputMode    = $state<'inline' | 'block'>('inline');
  let mathInputVal     = $state('');
  let savedRange: Range | null = null;
  let initialized      = false;

  // ── Init editor HTML once ─────────────────────────────────────────────────

  $effect(() => {
    if (editorRef && !initialized) {
      initialized = true;
      editorRef.innerHTML = nodesToHtml(nodes);
    }
  });

  // ── Escape helpers ─────────────────────────────────────────────────────────

  function escHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function escAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  }

  // ── Image style / HTML ────────────────────────────────────────────────────

  function imgStyle(entry: ImgEntry): string {
    if (entry.wrap && entry.align !== 'center') {
      const margin = entry.align === 'left'
        ? 'margin-right:0.75em;margin-bottom:0.5em;'
        : 'margin-left:0.75em;margin-bottom:0.5em;';
      return `float:${entry.align};${margin}width:${entry.width};max-height:250px;object-fit:contain;`;
    }
    const blk = entry.align === 'center' ? 'display:block;margin-left:auto;margin-right:auto;'
              : entry.align === 'right'  ? 'display:block;margin-left:auto;'
              : 'display:block;';
    return `${blk}width:${entry.width};max-height:250px;object-fit:contain;margin-bottom:0.5em;`;
  }

  function imgHtml(entry: ImgEntry): string {
    return `<img contenteditable="false" data-id="${entry.id}" src="${entry.src}" alt="${escAttr(entry.alt)}" style="${imgStyle(entry)}" class="rounded border editor-img">`;
  }

  // ── ContentNode[] → HTML (init) ───────────────────────────────────────────

  function nodesToHtml(ns: ContentNode[]): string {
    const srcMap = new Map(imgList.map(img => [img.src, img]));
    return ns.map(n => {
      if (n.type === 'text') {
        let html = escHtml(n.text).replace(/\n/g, '<br>');
        if (n.style.strikethrough) html = `<s>${html}</s>`;
        if (n.style.underline)     html = `<u>${html}</u>`;
        if (n.style.italic)        html = `<em>${html}</em>`;
        if (n.style.bold)          html = `<strong>${html}</strong>`;
        return html;
      }
      if (n.type === 'image') {
        const e = srcMap.get(n.src);
        return e ? imgHtml(e) : '';
      }
      if (n.type === 'math') {
        const rendered = katex.renderToString(n.raw, { displayMode: n.display === 'block', throwOnError: false });
        const cls = n.display === 'block' ? 'math-node math-block' : 'math-node';
        return `<span contenteditable="false" data-math="${n.display}" data-raw="${escAttr(n.raw)}" class="${cls}">${rendered}</span>`;
      }
      if (n.type === 'newline') return '<br>';
      return '';
    }).join('');
  }

  // ── DOM → ContentNode[] ────────────────────────────────────────────────────

  function getAncestorStyle(node: Node): TextStyle {
    let bold = false, italic = false, underline = false, strikethrough = false;
    let p = node.parentElement;
    while (p && p !== editorRef) {
      const tag = p.tagName;
      if (tag === 'STRONG' || tag === 'B') bold = true;
      if (tag === 'EM'     || tag === 'I') italic = true;
      if (tag === 'U') underline = true;
      if (tag === 'S' || tag === 'STRIKE') strikethrough = true;
      const st = (p as HTMLElement).style;
      if (st.fontWeight === 'bold' || parseInt(st.fontWeight) >= 700) bold = true;
      if (st.fontStyle === 'italic') italic = true;
      if (st.textDecoration?.includes('underline')) underline = true;
      if (st.textDecoration?.includes('line-through')) strikethrough = true;
      p = p.parentElement;
    }
    return { bold, italic, underline, strikethrough };
  }

  function domToNodes(): ContentNode[] {
    if (!editorRef) return [];
    const result: ContentNode[] = [];
    let pendingNewline = false;

    function pushNewlineIfNeeded() {
      if (pendingNewline && result.length > 0) result.push({ type: 'newline' });
      pendingNewline = false;
    }

    function walk(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const text = node.textContent ?? '';
        if (!text) return;
        pushNewlineIfNeeded();
        result.push({ type: 'text', text, style: getAncestorStyle(node) });
        return;
      }
      if (node.nodeType !== Node.ELEMENT_NODE) return;
      const elem = node as HTMLElement;

      if (elem.tagName === 'IMG') {
        pushNewlineIfNeeded();
        const id = elem.getAttribute('data-id') ?? '';
        const entry = imgList.find(img => img.id === id);
        if (entry) result.push({ type: 'image', src: entry.src, alt: entry.alt, align: entry.align, width: entry.width, wrap: entry.wrap });
        return;
      }
      if (elem.tagName === 'BR') {
        result.push({ type: 'newline' });
        pendingNewline = false;
        return;
      }
      if (elem.hasAttribute('data-math')) {
        pushNewlineIfNeeded();
        const raw     = elem.getAttribute('data-raw') ?? '';
        const display = elem.getAttribute('data-math') as 'inline' | 'block';
        result.push({ type: 'math', raw, display });
        return;
      }

      const isBlock = ['DIV', 'P', 'H1', 'H2', 'H3', 'LI'].includes(elem.tagName);
      if (isBlock && result.length > 0) pendingNewline = true;
      for (const child of Array.from(elem.childNodes)) walk(child);
      if (isBlock) pendingNewline = true;
    }

    for (const child of Array.from(editorRef.childNodes)) walk(child);
    return result;
  }

  // ── Emit ──────────────────────────────────────────────────────────────────

  function emit() { onchange?.(domToNodes()); }

  // ── Editor events ─────────────────────────────────────────────────────────

  function onEditorInput() {
    if (editorRef) {
      const domIds = new Set(
        Array.from(editorRef.querySelectorAll('img[data-id]'))
             .map(el => el.getAttribute('data-id') ?? '')
      );
      const next = imgList.filter(img => domIds.has(img.id));
      if (next.length !== imgList.length) imgList = next;
    }
    emit();
  }

  function onEditorBlur() {
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0) savedRange = sel.getRangeAt(0).cloneRange();
  }

  function onPaste(e: ClipboardEvent) {
    e.preventDefault();
    const text = e.clipboardData?.getData('text/plain') ?? '';
    document.execCommand('insertText', false, text);
  }

  function onKeyDown(e: KeyboardEvent) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      document.execCommand('insertLineBreak');
    }
  }

  // ── Insert HTML at cursor ──────────────────────────────────────────────────

  function insertAtCursor(html: string) {
    editorRef?.focus();
    let range: Range | null = null;
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && editorRef?.contains(sel.getRangeAt(0).commonAncestorContainer)) {
      range = sel.getRangeAt(0);
    } else if (savedRange && editorRef?.contains(savedRange.commonAncestorContainer)) {
      range = savedRange;
      sel?.removeAllRanges();
      sel?.addRange(range);
    }

    if (!range) {
      if (editorRef) {
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        while (tmp.firstChild) editorRef.appendChild(tmp.firstChild);
      }
      emit();
      return;
    }

    range.deleteContents();
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    const frag = document.createDocumentFragment();
    let lastNode: Node | null = null;
    while (tmp.firstChild) { lastNode = tmp.firstChild; frag.appendChild(tmp.firstChild); }
    range.insertNode(frag);
    if (lastNode) {
      const nr = document.createRange();
      nr.setStartAfter(lastNode);
      nr.collapse(true);
      sel?.removeAllRanges();
      sel?.addRange(nr);
    }
    emit();
  }

  // ── Text formatting ────────────────────────────────────────────────────────

  function execFmt(cmd: string) {
    editorRef?.focus();
    document.execCommand(cmd);
    emit();
  }

  // ── Math input ────────────────────────────────────────────────────────────

  function openMathInput(mode: 'inline' | 'block') {
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0) savedRange = sel.getRangeAt(0).cloneRange();
    mathInputMode    = mode;
    mathInputVal     = '';
    mathInputVisible = true;
    setTimeout(() => mathInputRef?.focus());
  }

  function commitMathInput() {
    const raw = mathInputVal.trim();
    mathInputVisible = false;
    mathInputVal     = '';
    if (!raw) { editorRef?.focus(); return; }
    if (savedRange) {
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(savedRange);
      savedRange = null;
    }
    const rendered = katex.renderToString(raw, { displayMode: mathInputMode === 'block', throwOnError: false });
    const cls = mathInputMode === 'block' ? 'math-node math-block' : 'math-node';
    insertAtCursor(`<span contenteditable="false" data-math="${mathInputMode}" data-raw="${escAttr(raw)}" class="${cls}">${rendered}</span>`);
  }

  // ── Equation editor symbol ────────────────────────────────────────────────

  function insertSym(latex: string) {
    const rendered = katex.renderToString(latex, { throwOnError: false });
    insertAtCursor(`<span contenteditable="false" data-math="inline" data-raw="${escAttr(latex)}" class="math-node">${rendered}</span>`);
  }

  // ── Image ─────────────────────────────────────────────────────────────────

  function onFile(e: Event) {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      const id = `i${_idc++}`;
      const entry: ImgEntry = { id, src: ev.target!.result as string, alt: file.name, align: 'center', width: '50%', wrap: false };
      imgList = [...imgList, entry];
      insertAtCursor(imgHtml(entry));
    };
    reader.readAsDataURL(file);
    (e.target as HTMLInputElement).value = '';
  }

  function delImg(i: number) {
    const entry = imgList[i];
    imgList = imgList.filter((_, k) => k !== i);
    editorRef?.querySelector(`img[data-id="${entry.id}"]`)?.remove();
    emit();
  }

  function updateImgStyle(i: number) {
    const entry = imgList[i];
    const img = editorRef?.querySelector(`img[data-id="${entry.id}"]`) as HTMLImageElement | null;
    if (img) img.setAttribute('style', imgStyle(entry));
    emit();
  }

  function toggleWrap(i: number) {
    imgList[i] = { ...imgList[i], wrap: !imgList[i].wrap };
    updateImgStyle(i);
  }
  function setImgAlign(i: number, align: ImgEntry['align']) {
    imgList[i] = { ...imgList[i], align };
    updateImgStyle(i);
  }
  function setImgWidth(i: number, pct: number) {
    imgList[i] = { ...imgList[i], width: `${pct}%` };
    updateImgStyle(i);
  }

  // ── Equation categories ────────────────────────────────────────────────────

  type EqItem = { sym: string; latex: string; title: string };
  type EqCat  = { label: string; items: EqItem[] };

  const EQ_CATS: EqCat[] = [
    { label: 'Yunan', items: [
      { sym: 'α', latex: '\\alpha',   title: 'alfa' },
      { sym: 'β', latex: '\\beta',    title: 'beta' },
      { sym: 'γ', latex: '\\gamma',   title: 'gama' },
      { sym: 'δ', latex: '\\delta',   title: 'delta' },
      { sym: 'ε', latex: '\\epsilon', title: 'epsilon' },
      { sym: 'θ', latex: '\\theta',   title: 'teta' },
      { sym: 'λ', latex: '\\lambda',  title: 'lambda' },
      { sym: 'μ', latex: '\\mu',      title: 'mü' },
      { sym: 'π', latex: '\\pi',      title: 'pi' },
      { sym: 'σ', latex: '\\sigma',   title: 'sigma' },
      { sym: 'φ', latex: '\\phi',     title: 'fi' },
      { sym: 'Δ', latex: '\\Delta',   title: 'büyük delta' },
      { sym: 'Σ', latex: '\\Sigma',   title: 'büyük sigma' },
      { sym: 'Ω', latex: '\\Omega',   title: 'büyük omega' },
    ]},
    { label: 'Aritmetik', items: [
      { sym: '×',   latex: '\\times',      title: 'çarpı' },
      { sym: '÷',   latex: '\\div',        title: 'bölü' },
      { sym: '±',   latex: '\\pm',         title: 'artı eksi' },
      { sym: '·',   latex: '\\cdot',       title: 'nokta çarpım' },
      { sym: 'a/b', latex: '\\frac{a}{b}', title: 'kesir' },
      { sym: '√x',  latex: '\\sqrt{x}',    title: 'karekök' },
      { sym: 'ⁿ√x', latex: '\\sqrt[n]{x}', title: 'n. kök' },
      { sym: 'xⁿ',  latex: 'x^{n}',        title: 'üs' },
      { sym: 'xₙ',  latex: 'x_{n}',        title: 'alt indis' },
      { sym: '|x|', latex: '|x|',           title: 'mutlak değer' },
    ]},
    { label: 'İlişki', items: [
      { sym: '≤', latex: '\\leq',    title: 'küçük eşit' },
      { sym: '≥', latex: '\\geq',    title: 'büyük eşit' },
      { sym: '≠', latex: '\\neq',    title: 'eşit değil' },
      { sym: '≈', latex: '\\approx', title: 'yaklaşık eşit' },
      { sym: '∞', latex: '\\infty',  title: 'sonsuz' },
    ]},
    { label: 'Analiz', items: [
      { sym: '∫',    latex: '\\int',           title: 'integral' },
      { sym: '∫ₐᵇ', latex: '\\int_a^b',        title: 'belirli integral' },
      { sym: '∑',    latex: '\\sum_{i=1}^{n}',  title: 'toplam' },
      { sym: 'lim',  latex: '\\lim_{x \\to 0}', title: 'limit' },
      { sym: 'd/dx', latex: '\\frac{d}{dx}',     title: 'türev' },
      { sym: '∂',    latex: '\\partial',          title: 'kısmi türev' },
    ]},
    { label: 'Küme', items: [
      { sym: '∈', latex: '\\in',        title: 'elemanı' },
      { sym: '⊂', latex: '\\subset',    title: 'alt küme' },
      { sym: '∪', latex: '\\cup',       title: 'birleşim' },
      { sym: '∩', latex: '\\cap',       title: 'kesişim' },
      { sym: '∅', latex: '\\emptyset',  title: 'boş küme' },
      { sym: 'ℝ', latex: '\\mathbb{R}', title: 'gerçel sayılar' },
    ]},
    { label: 'Mantık', items: [
      { sym: '∀', latex: '\\forall',         title: 'her için' },
      { sym: '∃', latex: '\\exists',         title: 'var olan' },
      { sym: '¬', latex: '\\neg',            title: 'değil' },
      { sym: '∧', latex: '\\land',           title: 've' },
      { sym: '∨', latex: '\\lor',            title: 'veya' },
      { sym: '⇒', latex: '\\Rightarrow',     title: 'öndeyişe' },
      { sym: '⟺', latex: '\\Leftrightarrow', title: 'ancak ve ancak' },
    ]},
    { label: 'Geometri', items: [
      { sym: '∠',  latex: '\\angle',    title: 'açı' },
      { sym: '∥',  latex: '\\parallel', title: 'paralel' },
      { sym: '⊥',  latex: '\\perp',    title: 'dik' },
      { sym: '△',  latex: '\\triangle', title: 'üçgen' },
      { sym: '→v', latex: '\\vec{v}',   title: 'vektör' },
      { sym: '°',  latex: '^{\\circ}',  title: 'derece' },
    ]},
  ];

  // ── LaTeX reference ────────────────────────────────────────────────────────

  const LATEX_REF = [
    { cat: 'Kesir',      code: '\\frac{a}{b}',           ex: '\\frac{3}{4}' },
    { cat: 'Karekök',    code: '\\sqrt{x}',              ex: '\\sqrt{16}' },
    { cat: 'n. Kök',     code: '\\sqrt[n]{x}',           ex: '\\sqrt[3]{8}' },
    { cat: 'Üs',         code: 'x^{n}',                   ex: '2^{10}' },
    { cat: 'Alt İndis',  code: 'x_{n}',                   ex: 'a_{1} + a_{2}' },
    { cat: 'İntegral',   code: '\\int_a^b f(x)\\,dx',    ex: '\\int_0^1 x^2\\,dx' },
    { cat: 'Toplam',     code: '\\sum_{i=1}^{n} a_i',     ex: '\\sum_{i=1}^{4} i^2' },
    { cat: 'Limit',      code: '\\lim_{x \\to 0} f(x)',   ex: '\\lim_{x\\to 0}\\frac{\\sin x}{x}' },
    { cat: 'Türev',      code: '\\frac{d}{dx} f(x)',       ex: '\\frac{d}{dx} x^3 = 3x^2' },
    { cat: 'Vektör',     code: '\\vec{v}',                ex: '\\vec{F} = m\\vec{a}' },
    { cat: 'Matris',     code: '\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}', ex: '\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}' },
    { cat: 'Pi',         code: '\\pi',                    ex: '\\pi r^2' },
    { cat: 'Sonsuz',     code: '\\infty',                 ex: 'n \\to \\infty' },
    { cat: 'Yunan',      code: '\\alpha, \\beta, \\gamma', ex: '\\alpha^2 + \\beta^2 = \\gamma^2' },
  ];

  const LATEX_TIPS = [
    'Süslü parantez { } birden fazla karakteri gruplar: x^{10}, \\frac{a+b}{c+d}',
    'Boşluklar formül içinde genellikle yoksayılır',
    'Formül butonuna (f(x) veya ∑) tıklayınca giriş kutusu açılır — LaTeX yazıp Enter\'a basın',
  ];
</script>

<div class="space-y-2">

  <!-- Toolbar -->
  <div class="flex flex-wrap items-center gap-1 rounded-md border border-input bg-muted/40 px-2 py-1.5">
    <button type="button" onmousedown={(e) => { e.preventDefault(); execFmt('bold'); }}
      title="Kalın (Ctrl+B)"
      class="w-7 rounded py-1 text-sm font-bold hover:bg-background transition-colors select-none">B</button>
    <button type="button" onmousedown={(e) => { e.preventDefault(); execFmt('italic'); }}
      title="İtalik (Ctrl+I)"
      class="w-7 rounded py-1 text-sm italic hover:bg-background transition-colors select-none">I</button>
    <button type="button" onmousedown={(e) => { e.preventDefault(); execFmt('underline'); }}
      title="Altı çizili (Ctrl+U)"
      class="w-7 rounded py-1 text-sm underline hover:bg-background transition-colors select-none">U</button>
    <button type="button" onmousedown={(e) => { e.preventDefault(); execFmt('strikeThrough'); }}
      title="Üstü çizili"
      class="w-7 rounded py-1 text-sm line-through hover:bg-background transition-colors select-none">S</button>

    <span class="mx-1 h-4 w-px shrink-0 bg-border"></span>

    <button type="button" onclick={() => openMathInput('inline')}
      title="Satır içi formül ekle"
      class="rounded px-2 py-1 text-sm font-mono hover:bg-background transition-colors select-none {mathInputVisible && mathInputMode === 'inline' ? 'bg-background ring-1 ring-ring' : ''}">
      <i>f</i>(x)
    </button>
    <button type="button" onclick={() => openMathInput('block')}
      title="Blok formül ekle (ortalanmış)"
      class="rounded px-2 py-1 text-sm hover:bg-background transition-colors select-none {mathInputVisible && mathInputMode === 'block' ? 'bg-background ring-1 ring-ring' : ''}">
      ∑
    </button>

    <span class="mx-1 h-4 w-px shrink-0 bg-border"></span>

    <button type="button" onclick={() => fileRef?.click()}
      title="Resim ekle"
      class="flex items-center gap-1.5 rounded px-2 py-1 text-sm hover:bg-background transition-colors select-none">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
        <circle cx="9" cy="9" r="2"/>
        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
      </svg>
      Resim
    </button>
    <input bind:this={fileRef} type="file" accept="image/*" class="hidden" onchange={onFile} />

    <span class="mx-1 h-4 w-px shrink-0 bg-border"></span>

    <button type="button"
      onclick={() => { showEqEditor = !showEqEditor; showLatexRef = false; }}
      title="Denklem editörü"
      class="flex items-center gap-0.5 rounded px-2 py-1 text-sm hover:bg-background transition-colors select-none {showEqEditor ? 'bg-background ring-1 ring-ring' : ''}">
      <span class="font-serif italic">Σ</span><span class="text-[10px]">x</span>
      <span class="ml-0.5 text-[10px] opacity-50">▾</span>
    </button>
    <button type="button"
      onclick={() => { showLatexRef = !showLatexRef; showEqEditor = false; }}
      title="LaTeX kılavuzu"
      class="ml-auto flex h-6 w-6 items-center justify-center rounded-full border text-xs font-bold hover:bg-background transition-colors select-none {showLatexRef ? 'bg-background ring-1 ring-ring' : 'text-muted-foreground'}">
      ?
    </button>
  </div>

  <!-- Math input panel -->
  {#if mathInputVisible}
    <div class="flex items-center gap-2 rounded-md border border-primary bg-card px-3 py-2">
      <span class="shrink-0 text-xs text-muted-foreground">{mathInputMode === 'inline' ? 'Satır içi' : 'Blok'} formül:</span>
      <input
        bind:this={mathInputRef}
        bind:value={mathInputVal}
        type="text"
        placeholder="LaTeX girin… örn: \frac&#123;a&#125;&#123;b&#125;"
        class="min-w-0 flex-1 bg-transparent font-mono text-sm focus:outline-none"
        onkeydown={(e) => {
          if (e.key === 'Enter')  { e.preventDefault(); commitMathInput(); }
          if (e.key === 'Escape') { mathInputVisible = false; editorRef?.focus(); }
        }}
      />
      {#if mathInputVal.trim()}
        <div class="shrink-0 border-l pl-2">
          <!-- eslint-disable-next-line svelte/no-at-html-tags -->
          {@html katex.renderToString(mathInputVal, { displayMode: mathInputMode === 'block', throwOnError: false })}
        </div>
      {/if}
      <button type="button" onclick={commitMathInput}
        class="shrink-0 rounded bg-primary px-2 py-0.5 text-xs text-primary-foreground hover:bg-primary/90">
        Ekle
      </button>
      <button type="button" onclick={() => { mathInputVisible = false; editorRef?.focus(); }}
        class="shrink-0 text-muted-foreground hover:text-foreground text-sm leading-none">✕</button>
    </div>
  {/if}

  <!-- Equation editor panel -->
  {#if showEqEditor}
    <div class="rounded-md border border-input bg-card p-2 space-y-2">
      <div class="flex flex-wrap gap-1">
        {#each EQ_CATS as cat, i}
          <button type="button" onclick={() => eqCategory = i}
            class="rounded px-2 py-0.5 text-xs font-medium transition-colors {eqCategory === i ? 'bg-primary text-primary-foreground' : 'hover:bg-muted text-muted-foreground'}">
            {cat.label}
          </button>
        {/each}
      </div>
      <div class="flex flex-wrap gap-1">
        {#each EQ_CATS[eqCategory].items as item}
          <button type="button" onclick={() => insertSym(item.latex)}
            title="{item.title} — {item.latex}"
            class="min-w-[2.75rem] rounded border bg-background px-2 py-1 text-center font-mono text-sm hover:bg-muted transition-colors">
            {item.sym}
          </button>
        {/each}
      </div>
    </div>
  {/if}

  <!-- WYSIWYG editing surface -->
  <!-- svelte-ignore a11y_no_static_element_interactions -->
  <div
    bind:this={editorRef}
    contenteditable="true"
    oninput={onEditorInput}
    onblur={onEditorBlur}
    onpaste={onPaste}
    onkeydown={onKeyDown}
    data-placeholder={placeholder}
    class="wysiwyg-editor min-h-[8rem] w-full rounded-md border border-input bg-background px-3 py-2 text-sm leading-relaxed overflow-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
  ></div>

  <!-- Image control cards -->
  {#each imgList as img, i}
    <div class="rounded border bg-card p-2 space-y-1.5 text-xs">
      <div class="flex flex-wrap items-center gap-2">
        <span class="max-w-[10rem] truncate font-medium">{img.alt}</span>
        <button type="button" onclick={() => toggleWrap(i)}
          title="Metin resmin etrafına sarsın"
          class="rounded border px-1.5 py-0.5 font-medium transition-colors {img.wrap ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-muted'}">
          ⇌ Sar
        </button>
        <div class="flex gap-0.5">
          <button type="button" onclick={() => setImgAlign(i, 'left')} title="Sola"
            class="rounded border px-2 py-0.5 transition-colors {img.align === 'left' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'}">←</button>
          <button type="button" onclick={() => setImgAlign(i, 'center')} title="Ortala"
            class="rounded border px-2 py-0.5 transition-colors {img.align === 'center' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'}">⊡</button>
          <button type="button" onclick={() => setImgAlign(i, 'right')} title="Sağa"
            class="rounded border px-2 py-0.5 transition-colors {img.align === 'right' ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'}">→</button>
        </div>
        <div class="ml-auto flex items-center gap-1.5">
          <span class="w-8 text-right tabular-nums text-muted-foreground">{img.width}</span>
          <input type="range" min="20" max="100" step="5"
            value={parseInt(img.width)}
            oninput={(e) => setImgWidth(i, parseInt((e.target as HTMLInputElement).value))}
            class="w-24 accent-primary"
          />
        </div>
        <button type="button" onclick={() => delImg(i)}
          class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-destructive text-xs text-destructive-foreground">
          ✕
        </button>
      </div>
      <img src={img.src} alt={img.alt} class="h-12 w-auto max-w-full rounded border object-contain" />
    </div>
  {/each}

  <!-- LaTeX reference panel -->
  {#if showLatexRef}
    <div class="rounded-md border bg-card text-sm">
      <div class="flex items-center justify-between border-b px-4 py-2.5">
        <h3 class="font-semibold">LaTeX Formül Kılavuzu</h3>
        <button type="button" onclick={() => showLatexRef = false}
          class="text-muted-foreground hover:text-foreground text-base leading-none transition-colors">✕</button>
      </div>
      <div class="p-4 space-y-5">
        <div class="space-y-2">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Formül Ekleme</p>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="rounded border bg-muted/30 px-3 py-2.5 space-y-1.5">
              <code class="block text-xs text-muted-foreground">Toolbar → f(x) → LaTeX yaz → Enter</code>
              <!-- eslint-disable-next-line svelte/no-at-html-tags -->
              <div>{@html katex.renderToString('x^2 + y^2 = z^2', { throwOnError: false })}</div>
              <p class="text-xs text-muted-foreground">Satır içi — metin arasında gösterilir</p>
            </div>
            <div class="rounded border bg-muted/30 px-3 py-2.5 space-y-1.5">
              <code class="block text-xs text-muted-foreground">Toolbar → ∑ → LaTeX yaz → Enter</code>
              <!-- eslint-disable-next-line svelte/no-at-html-tags -->
              <div>{@html katex.renderToString('\\int_0^1 x^2\\,dx', { displayMode: true, throwOnError: false })}</div>
              <p class="text-xs text-muted-foreground">Blok — ortalanmış büyük formül</p>
            </div>
          </div>
        </div>
        <div class="space-y-2">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Sık Kullanılan Komutlar</p>
          <div class="overflow-x-auto rounded border">
            <table class="w-full text-xs">
              <thead class="bg-muted/50 text-muted-foreground">
                <tr>
                  <th class="px-3 py-2 text-left font-medium">Açıklama</th>
                  <th class="px-3 py-2 text-left font-medium">Kod</th>
                  <th class="px-3 py-2 text-left font-medium">Görünüm</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {#each LATEX_REF as row}
                  <tr class="hover:bg-muted/20">
                    <td class="px-3 py-1.5 text-muted-foreground">{row.cat}</td>
                    <td class="px-3 py-1.5"><code class="rounded bg-muted px-1 py-0.5 text-[11px]">{row.code}</code></td>
                    <td class="px-3 py-1.5">
                      <!-- eslint-disable-next-line svelte/no-at-html-tags -->
                      {@html katex.renderToString(row.ex, { throwOnError: false })}
                    </td>
                  </tr>
                {/each}
              </tbody>
            </table>
          </div>
        </div>
        <div class="rounded border bg-muted/30 px-3 py-2.5 space-y-1">
          <p class="text-xs font-medium">İpuçları</p>
          {#each LATEX_TIPS as tip}
            <p class="text-xs text-muted-foreground">• {tip}</p>
          {/each}
        </div>
      </div>
    </div>
  {/if}

</div>

<style>
  .wysiwyg-editor:empty::before {
    content: attr(data-placeholder);
    color: var(--muted-foreground, #888);
    pointer-events: none;
  }
  :global(.math-node) {
    display: inline-block;
    cursor: default;
    user-select: none;
    padding: 0 2px;
    vertical-align: middle;
  }
  :global(.math-block) {
    display: block;
    text-align: center;
    margin: 0.5em 0;
    user-select: none;
  }
  :global(.editor-img) {
    cursor: default;
  }
</style>
